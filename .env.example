# ─── UniPulse AI — Environment Configuration ────────────────────────────────
# Copy this file to .env.local and fill in your real keys.
# After editing .env.local, restart the app for the changes to take effect.

# ── Database (already configured in this workspace) ──
DATABASE_URL=file:/home/z/my-project/db/custom.db

# ── Z.ai GLM Agent Engine ──
# In this Z.ai workspace the agent works out of the box via the bundled SDK.
# When self-hosting outside Z.ai, create a key at https://z.ai (API Keys) and
# paste it here:
ZAI_API_KEY=

# ── Google OAuth 2.0 (Gmail Gate) ──
# Get these from Google Cloud Console (Testing mode, $0 cost):
# 1. console.cloud.google.com → create/select a project
# 2. APIs & Services → Library → enable "Gmail API"
# 3. APIs & Services → OAuth consent screen → External → add your Gmail as Test user
# 4. APIs & Services → Credentials → Create Credentials → OAuth client ID
#    → Application type: Web application
#    → Authorized redirect URI: http://localhost:3000/api/auth/callback
# 5. Copy the Client ID and Client Secret here:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Public app URL (must match the redirect URI origin above) ──
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NOTE: The Moodle .ics calendar URL is NOT an env var — it is pasted once
# inside the app via the "Connect Accounts" modal (stored in the database).
