generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Singleton configuration row for the student profile + connected accounts
model UserConfig {
  id                 String    @id @default("singleton")
  studentName        String    @default("Student")
  moodleIcsUrl       String?
  googleAccessToken  String?
  googleRefreshToken String?
  googleTokenExpiry  DateTime?
  gmailConnected     Boolean   @default(false)
  gmailHistoryId     String?
  timezone           String    @default("Europe/Budapest")
  lastSyncAt         DateTime?
  updatedAt          DateTime  @updatedAt
}

// Every raw inbound item (email / ics event / demo injection) lands here first.
// sourceId is unique => deduplication gate so nothing is ever processed twice.
model RawFeedItem {
  id         String   @id @default(cuid())
  source     String // gmail | moodle | demo
  sourceId   String   @unique
  subject    String
  body       String
  receivedAt DateTime
  processed  Boolean  @default(false)
  discarded  Boolean  @default(false)
  createdAt  DateTime @default(now())
}

// AI-processed, structured action item. sourceId dedup protects against re-ingestion.
model Task {
  id             String           @id @default(cuid())
  sourceId       String           @unique
  source         String // Neptun | Moodle | Immigration | Medical | Professor
  category       String // Exam | Quiz | Appointment | Admin | Reply Required
  title          String
  eventDatetime  DateTime?
  isFixedEvent   Boolean          @default(false)
  urgencyScore   Int              @default(5)
  requiresReply  Boolean          @default(false)
  suggestedReply String?
  prepHours      Float            @default(0)
  rawSubject     String?
  rawBody        String?
  status         String           @default("pending") // pending | done | dismissed
  aiProcessed    Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  blocks         ScheduledBlock[]
}

// Calendar blocks: locked fixed commitments vs AI-scheduled prep blocks
model ScheduledBlock {
  id            String    @id @default(cuid())
  taskId        String?
  task          Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  type          String // fixed | prep
  title         String
  start         DateTime
  end           DateTime
  locked        Boolean   @default(false)
  priority      Int       @default(5)
  autoAdjusted  Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Audit log of autonomous schedule adjustments for the "Schedule Auto-Adjusted" toasts
model ScheduleAdjustment {
  id          String   @id @default(cuid())
  summary     String
  detail      String
  acknowledged Boolean @default(false)
  createdAt   DateTime @default(now())
}
